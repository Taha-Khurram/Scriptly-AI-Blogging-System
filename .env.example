# Scriptly environment variables.
#
# Copy to `.env` for local development, or set these in your host's dashboard.
# Do NOT commit real values — `.env` is gitignored.
#
# Only the variables under "Required" have no safe default. Everything else has
# one and is listed with the reasoning for its value, so you can tune without
# reading the source.

# =============================================================================
# Required
# =============================================================================

# development | testing | production
# Defaults to `production` when unset: an unset or misspelled value must select
# the SAFE configuration, not the one with an insecure cookie and a dev key.
FLASK_ENV=development

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ProductionConfig.validate() refuses to boot on a placeholder or on anything
# under 32 characters — a guessable key here means forgeable sessions.
SECRET_KEY=

# Firebase Admin credentials. Either an absolute path to the service-account
# file, OR the full JSON as a single-line string. On a hosted platform, paste
# the raw JSON.
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Google Gemini. Every AI feature depends on it, so production will not start
# without one.
GEMINI_API_KEY=

# =============================================================================
# Firebase Web SDK (client config, safe to expose to the browser)
# =============================================================================
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_PROJECT_ID=
# Also the bucket gallery uploads are written to.
FB_STORAGE_BUCKET=
FB_SENDER_ID=
FB_APP_ID=
FB_MEASUREMENT_ID=

# =============================================================================
# Redis — optional, only needed for MULTIPLE INSTANCES
# =============================================================================
# Leave this empty unless you run more than one instance. Sessions, the cache
# and rate-limit counters are all backed by the local SQLite store
# (SQLITE_STORE_PATH below), which is shared across every thread and worker
# process on one host -- so a single instance needs nothing here.
#
# What Redis adds is sharing across *separate instances*. Without it, each
# instance keeps its own:
#   * cache            -> an invalidation in one instance does not reach the
#                         others, so they serve the previous version until the
#                         entry's TTL expires
#   * sessions         -> a user would bounce between instances and be asked to
#                         sign in again depending on which one answered
#   * rate-limit counts -> the effective limit multiplies by the instance count
#   * scheduler lease   -> falls back to a per-machine file lock, so two
#                         instances could both publish the same scheduled post
#
# /healthz reports which guarantees are actually in force:
# `shared_across_workers` vs `shared_across_instances`.
REDIS_URL=

# =============================================================================
# Optional — every value below is the default
# =============================================================================

# --- Logging / observability ---
# json for machine-readable production logs, console for readable local ones.
LOG_FORMAT=console
LOG_LEVEL=DEBUG
# Any request slower than this is logged at WARNING.
SLOW_REQUEST_MS=2000
# Per-request Firestore round-trip accounting. Page latency here is round-trip
# COUNT x round-trip latency (measured: 0.5-3.5 s per trip), not CPU -- so this,
# not cProfile, is what explains a slow page. With it on, every response carries
# X-DB-Queries and X-DB-Ms, any request over SLOW_REQUEST_MS logs a per-query
# breakdown naming the repository method that issued each one, and duplicated
# queries within a request are flagged. Costs a stack walk per query: leave it
# off in production. Append ?_profile=1 to a URL for a cProfile table too.
PROFILE_QUERIES=false
# With a DSN set and sentry-sdk installed, unhandled exceptions are reported.
SENTRY_DSN=

# --- Sessions ---
# Where session contents live.
#   sqlite  (default) server-side. The cookie carries only an opaque random id;
#           the contents live in a row, so a session can be REVOKED -- deleting
#           or demoting a user ends their access immediately instead of when
#           their cookie expires.
#   cookie  Flask's default client-side signed cookie. Escape hatch only: it
#           cannot revoke, so a demoted admin keeps admin access for up to
#           SESSION_TIMEOUT_MINUTES.
SESSION_BACKEND=sqlite

# Inactivity timeout, in minutes. Sliding: the stored expiry moves forward as
# the session is used, so this is time-since-last-activity, not a hard cap.
#
# Ten minutes, not the eight hours this used to be. A dashboard session can
# publish, delete posts, change roles and remove accounts, so an eight-hour idle
# window left an unattended browser fully privileged for the rest of the day.
#
# A window this short is only usable because activity genuinely extends it: the
# frontend sends a throttled heartbeat (POST /api/session/heartbeat) while the
# user is interacting -- including inside the TinyMCE editor, whose keystrokes
# happen in an iframe and would otherwise be invisible to both the page and the
# server. Nothing in the editor autosaves, so the user is also warned
# SESSION_WARNING_SECONDS before expiry.
SESSION_TIMEOUT_MINUTES=10

# How long before expiry the browser warns, in seconds. The warning invites the
# user to click and stay signed in, which also fires a heartbeat.
SESSION_WARNING_SECONDS=60

# Hard cap on session age regardless of activity, in hours. The sliding timeout
# above never expires a session that keeps being used, so on its own it means
# "forever" for an active client. 0 disables the cap. 720h = 30 days.
SESSION_ABSOLUTE_HOURS=720

# How often the sliding expiry is actually written back. Moving it is a write,
# so doing it per request means a disk write per request; this batches it.
#
# It is also the slack on the idle timeout: a request arriving inside the
# throttle window does not push the expiry out, so the real window is
# (timeout - touch) to timeout -- 9m30s to 10m at these values. Raising this
# without raising SESSION_TIMEOUT_MINUTES shortens the real timeout.
SESSION_TOUCH_SECONDS=30

# Where the session / rate-limit database lives. Empty = Flask's instance_path
# (./instance/scriptly.db), which sits outside the application tree so
# WhiteNoise never serves it and a source deploy does not overwrite it.
#
# NOTE: this store is shared across the threads AND worker processes of one
# host (SQLite WAL), but NOT across separate instances. With more than one
# instance, sessions would not be shared and the effective rate limit would be
# multiplied by the instance count. On an ephemeral filesystem the file is lost
# when the container is replaced, which signs everyone out; the frontend holds
# the Firebase credential and re-authenticates silently.
SQLITE_STORE_PATH=

# --- Request limits ---
# Rejected by Werkzeug at the WSGI layer, before any view runs. Without it, an
# upload route that reads the body into memory can be used to exhaust the
# instance with a single request.
MAX_CONTENT_LENGTH_MB=8

# --- Uploads ---
# firebase = durable object storage (survives deploys, shared across
# instances). local = the container filesystem, for offline development only:
# it is wiped on every deploy while the Firestore metadata survives, leaving
# permanently broken image links.
UPLOAD_BACKEND=firebase
UPLOAD_MAX_MB=5

# --- AI ---
# One knob for the model name. This project has already had to migrate models
# twice over quota errors; changing it here beats editing nine files.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# A ~1200-word generation routinely exceeds the SDK's 60s default, which
# surfaced as "504 Deadline Exceeded".
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=2

# --- Rate limiting ---
# Counters are stored in the same SQLite database as sessions, so they are
# shared across this instance's workers and threads and survive a reload. They
# were previously in-process, which meant N gunicorn workers permitted N times
# the configured rate and every reload reset the window -- a limit that reads
# as protection without being any.
#
# On by default in development too, so the limiter you test is the limiter that
# ships. Set false while hammering an endpoint by hand.
RATELIMIT_ENABLED=true
# Applied to any route that does not declare its own limit, so a new endpoint
# is protected by default rather than by remembering a decorator.
RATELIMIT_DEFAULT=1200 per hour
# Public, unauthenticated endpoints that spend a Gemini call per request.
RATELIMIT_PUBLIC_AI=10 per minute
RATELIMIT_PUBLIC_WRITE=5 per minute
RATELIMIT_AUTH=20 per minute
# Authenticated blog generation. Each call is minutes of AI work, so the budget
# is per hour rather than per minute.
RATELIMIT_AI_GENERATE=30 per hour

# --- Background AI tasks ---
# Pool size for blog generation and humanisation. Was hardcoded to 2 —
# platform-wide, across every user.
TASK_MAX_WORKERS=4
# Admission limit. Past this, submission is refused with a 503 and a
# Retry-After rather than silently queueing a user behind multi-minute jobs
# with no feedback.
TASK_MAX_QUEUE_DEPTH=20
# How long a finished task's status stays pollable.
TASK_RETENTION_SECONDS=1800

# --- Scheduler (auto-publish) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Lease duration. Must exceed a normal publish run, or a second worker could
# start one while the first is still going.
SCHEDULER_LOCK_TTL_SECONDS=90

# --- Cache ---
CACHE_DEFAULT_TTL=300
# Namespace, so several environments can share one Redis instance safely.
CACHE_KEY_PREFIX=scriptly

# --- Static assets ---
# 0 in development so an edited CSS file is served fresh.
STATIC_MAX_AGE=0

# --- Security headers ---
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# =============================================================================
# Third-party integrations (features degrade without them)
# =============================================================================

# RapidAPI — SEO keyword research, URL analysis, site audit
RAPIDAPI_KEY=
AHREFS_RAPIDAPI_KEY=
SITE_AUDIT_RAPIDAPI_KEY=

# Email (Gmail SMTP) for newsletters and team invitations
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME=Scriptly

# Google OAuth for the Analytics integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Sheets sync (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=

# =============================================================================
# Local development server only
# =============================================================================
# Port for `python main.py`.
PORT=5000
# Thread count when main.py falls back to waitress (gunicorn is not available
# on Windows).
WAITRESS_THREADS=8

# =============================================================================
# Production server (gunicorn.conf.py reads these)
# =============================================================================
# Worker processes. Keep at 1 until the AI task pool moves to a shared broker:
# task state lives in the worker that accepted the job, so a status poll can
# land on a worker that has never heard of that task id. gunicorn.conf.py warns
# at boot if this is raised.
WEB_CONCURRENCY=1
# Threads per worker. Threads, not processes, are the lever here — nearly every
# request is waiting on Firestore or Gemini, so a thread costs a stack and buys
# a concurrent I/O wait, while a process costs a whole interpreter (250-350 MB
# for this dependency set).
GUNICORN_THREADS=8
