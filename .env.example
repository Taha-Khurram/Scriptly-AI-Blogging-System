# Scriptly environment variables.
#
# Copy to `.env` for local development, or set these in your host's dashboard.
# Do NOT commit real values — `.env` is gitignored.
#
# Only the variables under "Required" have no safe default. Everything else has
# one and is listed with the reasoning for its value, so you can tune without
# reading the source.

# =============================================================================
# Required
# =============================================================================

# development | testing | production
# Defaults to `production` when unset: an unset or misspelled value must select
# the SAFE configuration, not the one with an insecure cookie and a dev key.
FLASK_ENV=development

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ProductionConfig.validate() refuses to boot on a placeholder or on anything
# under 32 characters — a guessable key here means forgeable sessions.
SECRET_KEY=

# Firebase Admin credentials. Either an absolute path to the service-account
# file, OR the full JSON as a single-line string. On a hosted platform, paste
# the raw JSON.
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Google Gemini. Every AI feature depends on it, so production will not start
# without one.
GEMINI_API_KEY=

# =============================================================================
# Firebase Web SDK (client config, safe to expose to the browser)
# =============================================================================
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_PROJECT_ID=
# Also the bucket gallery uploads are written to.
FB_STORAGE_BUCKET=
FB_SENDER_ID=
FB_APP_ID=
FB_MEASUREMENT_ID=

# =============================================================================
# Redis — strongly recommended in production
# =============================================================================
# Backs three things that are otherwise per-process:
#   * the cache            -> invalidation does not reach other workers
#   * rate-limit counters   -> effective limits multiply by the worker count
#   * the scheduler lease   -> falls back to a per-machine file lock
# The app boots without it and /healthz reports the degradation.
REDIS_URL=

# =============================================================================
# Optional — every value below is the default
# =============================================================================

# --- Logging / observability ---
# json for machine-readable production logs, console for readable local ones.
LOG_FORMAT=console
LOG_LEVEL=DEBUG
# Any request slower than this is logged at WARNING.
SLOW_REQUEST_MS=2000
# With a DSN set and sentry-sdk installed, unhandled exceptions are reported.
SENTRY_DSN=

# --- Sessions ---
# Inactivity timeout. Sliding: the cookie is re-stamped on every request, so
# this is time-since-last-request, not a hard cap. 8h suits a writing tool
# where someone may draft for a long stretch without issuing a request.
SESSION_TIMEOUT_MINUTES=480

# --- Request limits ---
# Rejected by Werkzeug at the WSGI layer, before any view runs. Without it, an
# upload route that reads the body into memory can be used to exhaust the
# instance with a single request.
MAX_CONTENT_LENGTH_MB=8

# --- Uploads ---
# firebase = durable object storage (survives deploys, shared across
# instances). local = the container filesystem, for offline development only:
# it is wiped on every deploy while the Firestore metadata survives, leaving
# permanently broken image links.
UPLOAD_BACKEND=firebase
UPLOAD_MAX_MB=5

# --- AI ---
# One knob for the model name. This project has already had to migrate models
# twice over quota errors; changing it here beats editing nine files.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# A ~1200-word generation routinely exceeds the SDK's 60s default, which
# surfaced as "504 Deadline Exceeded".
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=2

# --- Rate limiting ---
# Disabled by default in development, where one developer generates no load and
# limits only get in the way of manual testing.
RATELIMIT_ENABLED=false
RATELIMIT_DEFAULT=1200 per hour
# Public, unauthenticated endpoints that spend a Gemini call per request.
RATELIMIT_PUBLIC_AI=10 per minute
RATELIMIT_PUBLIC_WRITE=5 per minute
RATELIMIT_AUTH=20 per minute
# Authenticated blog generation. Each call is minutes of AI work, so the budget
# is per hour rather than per minute.
RATELIMIT_AI_GENERATE=30 per hour

# --- Background AI tasks ---
# Pool size for blog generation and humanisation. Was hardcoded to 2 —
# platform-wide, across every user.
TASK_MAX_WORKERS=4
# Admission limit. Past this, submission is refused with a 503 and a
# Retry-After rather than silently queueing a user behind multi-minute jobs
# with no feedback.
TASK_MAX_QUEUE_DEPTH=20
# How long a finished task's status stays pollable.
TASK_RETENTION_SECONDS=1800

# --- Scheduler (auto-publish) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Lease duration. Must exceed a normal publish run, or a second worker could
# start one while the first is still going.
SCHEDULER_LOCK_TTL_SECONDS=90

# --- Cache ---
CACHE_DEFAULT_TTL=300
# Namespace, so several environments can share one Redis instance safely.
CACHE_KEY_PREFIX=scriptly

# --- Static assets ---
# 0 in development so an edited CSS file is served fresh.
STATIC_MAX_AGE=0

# --- Security headers ---
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# =============================================================================
# Third-party integrations (features degrade without them)
# =============================================================================

# RapidAPI — SEO keyword research, URL analysis, site audit
RAPIDAPI_KEY=
AHREFS_RAPIDAPI_KEY=
SITE_AUDIT_RAPIDAPI_KEY=

# Email (Gmail SMTP) for newsletters and team invitations
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME=Scriptly

# Google OAuth for the Analytics integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Sheets sync (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=

# =============================================================================
# Local development server only
# =============================================================================
# Port for `python main.py`.
PORT=5000
# Thread count when main.py falls back to waitress (gunicorn is not available
# on Windows).
WAITRESS_THREADS=8

# =============================================================================
# Production server (gunicorn.conf.py reads these)
# =============================================================================
# Worker processes. Keep at 1 until the AI task pool moves to a shared broker:
# task state lives in the worker that accepted the job, so a status poll can
# land on a worker that has never heard of that task id. gunicorn.conf.py warns
# at boot if this is raised.
WEB_CONCURRENCY=1
# Threads per worker. Threads, not processes, are the lever here — nearly every
# request is waiting on Firestore or Gemini, so a thread costs a stack and buys
# a concurrent I/O wait, while a process costs a whole interpreter (250-350 MB
# for this dependency set).
GUNICORN_THREADS=8
